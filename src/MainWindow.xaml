<Window x:Class="CryptoTerminalLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        Title="Crypto Terminal Launcher"
        Height="520"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        Foreground="#cccccc">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Crypto Terminal Launcher"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#007acc"
                   Margin="0,0,0,20"/>

        <ListBox Grid.Row="1"
                 x:Name="lstTerminals"
                 SelectionChanged="LstTerminals_SelectionChanged"
                 Foreground="#cccccc"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2d2d2d"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#ffffff"/>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="12"
                                           Foreground="#9cdcfe"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding IsOpenSource, Converter={StaticResource OpenSourceConverter}}"
                                           FontSize="11"
                                           Foreground="#107c10"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Launch"
                                    Width="80"
                                    Height="32"
                                    Background="#107c10"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Tag="{Binding Name}"
                                    Click="LaunchButton_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StatusBar Grid.Row="2" Margin="0,20,0,0" Background="#2d2d2d" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Foreground="#888888" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>